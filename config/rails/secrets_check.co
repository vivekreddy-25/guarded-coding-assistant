# secrets_check.co
# Wires the custom secrets-detection Python action into the output rail.
# Runs after NeMo's built-in self_check_output, as a second pass.

define subflow check output secrets
  $is_secret_leak = execute check_output_for_secrets
  if $is_secret_leak
    bot refuse to respond secrets
    stop

define bot refuse to respond secrets
  "I can't share that response — it appears to contain sensitive information like API keys, passwords, or credentials."